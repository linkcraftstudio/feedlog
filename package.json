    "@mastra/pg": "1.25.0",
    "@modelcontextprotocol/server": "2.2.0",
    "@nuxt/eslint": "1.15.2",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/hints": "1.0.0-alpha.10",
    "@nuxt/icon": "2.2.1",
