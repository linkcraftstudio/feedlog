# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example
.dev.vars
!.dev.vars.example
.ali_ram

# Deploy artifacts
.vercel/
.wrangler/
.vercel
.env*.local

# Agent scratch space (screenshots, debug dumps, ad-hoc scripts)
tmp/
.playwright-mcp/

# Local-only working notes and credentials — never committed
/local/
# Any local/ folder, at any depth. Belt and braces: nested tools carry their own
# .gitignore, but those only exist on branches where the tool exists, and a
# credential must not become committable just because a branch predates it.
local/
**/local/
